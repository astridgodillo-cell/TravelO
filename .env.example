VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optionnel : IDs d'affiliation pour toucher des commissions sur les
# réservations effectuées via les liens "Réserver" des activités.
# Inscription gratuite :
#   GetYourGuide  → https://partner.getyourguide.com/
#   Tiqets        → https://www.tiqets.com/en/affiliates/
#   Booking.com   → https://partner.booking.com/fr/programme-daffiliation
#                   (commission ~4% du prix de la nuit, paiement mensuel)
#   DiscoverCars  → https://www.discovercars.com/affiliate
#                   (location de voiture, ~70% de la marge, cookie 365 jours)
VITE_GYG_PARTNER_ID=
VITE_TIQETS_PARTNER_ID=
VITE_BOOKING_AFFILIATE_ID=
# Identifiant d'affilié DiscoverCars (public). Par défaut "TravelO" dans le code.
VITE_DISCOVERCARS_AID=TravelO
